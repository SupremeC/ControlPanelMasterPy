{
  "name": "panelen-streamdeck",
  "private": true,
  "version": "0.1.0",
  "description": "Stream Deck + plugin for the Control Panel web API",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.supremec.panelen\"",
    "test": "node test/fake-host.mjs",
    "images": "python make_images.py",
    "profile": "python make_profile.py",
    "pack": "streamdeck pack com.supremec.panelen.sdPlugin --force"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.2",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "~24.1.0",
    "rollup": "^4.0.2",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.2"
  }
}
